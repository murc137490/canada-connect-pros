# Copy this file to .env and fill in your values.
# Get these from: Supabase Dashboard → your project → Settings → API
# IMPORTANT: Use the "anon" "public" key (long JWT starting with eyJ...).
# Do NOT use "publishable" or "sb_publishable_..." — that is not the API key.

# Production site URL (no trailing path required). Used for email confirmation + password-reset
# redirects so links never point at localhost after deploy. Must match an entry in Supabase →
# Authentication → URL Configuration → Redirect URLs (e.g. https://www.premiereservices.ca/**).
# VITE_SITE_URL=https://www.premiereservices.ca
#
# Google “Continue with Google” (Auth page):
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# 2. Authorized redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# 3. Supabase → Authentication → Providers → Google → enable + paste Client ID & Secret
# 4. Add https://www.premiereservices.ca/auth** (and localhost) under Redirect URLs

# Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key (long JWT, starts with eyJ... — NOT the sb_publishable_... value)
VITE_SUPABASE_ANON_KEY=your_anon_jwt_here

# Optional (frontend fallback): Google API key for Places autocomplete / client geocode.
# Prefer server geocode: set GOOGLE_MAPS_API_KEY on the Supabase Edge Function `geocode` (Geocoding API enabled).
# Edge order for Canadian postals: Google postal_code components → geocoder.ca (full LDU) → Zippopotam FSA.
# Zippopotam alone is FSA-only (e.g. all H3Z* share one point) — deploy geocode after changes.
# Client key (if used): restrict HTTP referrers to https://www.premiereservices.ca/* and http://localhost:*
# VITE_GOOGLE_PLACES_API_KEY=your_google_api_key
# Or: VITE_GOOGLE_MAPS_API_KEY=your_google_api_key
#
# Supabase → Edge Functions → Secrets:
#   GOOGLE_MAPS_API_KEY=your_google_api_key
# Then deploy: supabase functions deploy geocode

# Square (for booking payments). See docs/SQUARE-SETUP.md for where to find credentials.
# Application ID (frontend) — Developer Dashboard → Applications → your app → Credentials → Application ID:
# VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-...
# Location ID (frontend) — Developer Dashboard or Square Dashboard → Locations:
# VITE_SQUARE_LOCATION_ID=L...
# Access token: NEVER in frontend. Add in Supabase Dashboard → Edge Functions → square-create-payment → Secrets: SQUARE_ACCESS_TOKEN

# Square Connect (per-pro payouts): see section 6 below. OAuth secrets are set on the square-oauth-* and square-create-payment functions.

# Monitor admins — only these five accounts (hardcoded allowlist). Comma-separated, no spaces.
# VITE_PLATFORM_ADMIN_EMAILS=admin1@premiereservices.ca,admin2@premiereservices.ca,admin3@premiereservices.ca,admin4@premiereservices.ca,admin5@premiereservices.ca
#
# Supabase → Edge Functions → Secrets (must match exactly):
#   PLATFORM_ADMIN_EMAILS=admin1@premiereservices.ca,admin2@premiereservices.ca,admin3@premiereservices.ca,admin4@premiereservices.ca,admin5@premiereservices.ca
# Migrations: 20260529120000_platform_admin_config_secrets.sql, 20260531200000_platform_admin_allowlist_five.sql
# Deploy ensure-platform-admin; each admin signs in once to sync profiles.is_platform_admin.

